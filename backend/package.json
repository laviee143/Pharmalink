{
  "name": "pharmalink-backend",
  "version": "1.0.0",
  "description": "PharmaLink B2B pharmacy-wholesaler platform backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm run build:clean && npm run build:compile",
    "build:clean": "rimraf dist",
    "build:compile": "babel src -d dist --copy-files",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --testPathPattern=tests/unit --coverage",
    "test:integration": "jest --testPathPattern=tests/integration --coverage",
    "test:e2e": "jest --testPathPattern=tests/e2e --coverage",
    "test:watch": "jest --watch",
    "test:smoke": "jest --testPathPattern=tests/smoke",
    "test:performance": "jest --testPathPattern=tests/performance",
    "lint": "eslint src/ --ext .js,.ts",
    "lint:fix": "eslint src/ --ext .js,.ts --fix",
    "lint:check": "eslint src/ --ext .js,.ts --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,md}\"",
    "type-check": "tsc --noEmit",
    "complexity:check": "complexity-report -o complexity-report.json src/",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "generate": "prisma generate",
    "seed": "node src/seed.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "docker:build": "docker build -t pharmalink-backend .",
    "docker:run": "docker run -p 5000:5000 pharmalink-backend",
    "security:audit": "npm audit --audit-level high",
    "bundlesize": "bundlesize"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "bundlesize": "^0.18.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "prisma": "^5.6.0",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "pharmacy",
    "wholesaler",
    "b2b",
    "procurement",
    "inventory",
    "nodejs",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "PharmaLink Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laviee143/Pharmalink.git"
  },
  "bugs": {
    "url": "https://github.com/laviee143/Pharmalink/issues"
  },
  "homepage": "https://github.com/laviee143/Pharmalink#readme"
}
